# ── Database (MySQL) ─────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nexus_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DB=nexus_db

# ── Redis (Job Queue & Rate Limiter) ──────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_redis_password

# ── AI Provider (LiteLLM Proxy) ───────────────────────────────────────────
LITELLM_API_BASE=http://localhost:4000
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=asia-southeast2

# ── Security & Encryption — REQUIRED. No defaults. Must be set. ───────────
# Generate ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate ADMIN_API_KEY:  python -c "import secrets; print('nexus-live-' + secrets.token_hex(32))"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_GENERATED_KEY
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# ── Application ───────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
PORT=8100
HOST=127.0.0.1

# ── LLM Retry Policy ─────────────────────────────────────────────────────
# Applies to all modules: chat, ocr, summarize
LLM_MAX_RETRY_ATTEMPTS=3
LLM_RETRY_WAIT_MIN_SEC=2
LLM_RETRY_WAIT_MAX_SEC=10
LLM_RETRY_MULTIPLIER=1.0

# ── Webhook Dispatch Retry Policy ────────────────────────────────────────
WEBHOOK_MAX_RETRY_ATTEMPTS=4
WEBHOOK_RETRY_MULTIPLIER=1.5
WEBHOOK_RETRY_WAIT_MIN_SEC=2
WEBHOOK_RETRY_WAIT_MAX_SEC=10
WEBHOOK_TIMEOUT_SEC=10.0

# ── Authentication Cache ──────────────────────────────────────────────────
AUTH_CACHE_TTL_SEC=300

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_CONFIG_CACHE_TTL_SEC=600
DEFAULT_RPM=60
DEFAULT_RPD=10000
TOKEN_HOURLY_LIMIT=10000000

# ── Background Worker ─────────────────────────────────────────────────────
WORKER_MAX_JOBS=4

# ── Database Connection Pool ──────────────────────────────────────────────
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SEC=3600
